# Obtain a key from the provider's official dashboard.
# Never commit a real key.
DARKFOOTPRINT_ONIONSEARCHENGINE_API_KEY=

# Optional. Direct onion verification accepts only socks5h on loopback.
DARKFOOTPRINT_TOR_PROXY=socks5h://127.0.0.1:9050

# Optional path to a non-secret JSON configuration file.
# DARKFOOTPRINT_CONFIG=C:\\path\\to\\config.json
